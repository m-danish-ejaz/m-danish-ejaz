# ==========================================
# Dependencies
# ==========================================
# Third-party packages should not be committed to Git.
# They are managed via package.json and can be reinstalled.
node_modules/
/jspm_packages/
/web_modules/
/.pnp
.pnp.js

# ==========================================
# Production / Build Outputs
# ==========================================
# Compiled files should be excluded as they are generated on build.
/build/
/dist/
/out/
/.next/

# ==========================================
# Local Environment Variables
# ==========================================
# Never commit your private API keys, secrets, or database passwords.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Note: Keep '.env.example' unignored so team members know which keys to set.
!.env.example

# ==========================================
# Debug and Logs
# ==========================================
# Logs generated during errors or debugging.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Testing & Code Quality Cache
# ==========================================
# Coverage reports and linting/formatting caches.
/coverage/
.nyc_output/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ==========================================
# Platform-Specific / Vercel
# ==========================================
# Hosting/deployment caches and local configurations.
.vercel
.turbo/

# ==========================================
# System / OS Files
# ==========================================
# Folder attributes created by macOS and Windows.
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ==========================================
# IDEs and Editors
# ==========================================
# Custom configurations for text editors and development environments.
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?